<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — The Vyzkaris Covenant</title>
<meta name="description" content="{{ description or 'The Vyzkaris Covenant — order within chaos, strength through unity.' }}">
<link rel="stylesheet" href="{{ '/assets/css/theme.css' | url }}">
</head>
<body>
<div class="backdrop"></div>

<header class="site-header">
  <div class="header-top">
    <div class="brand">
      <span class="sigil"></span>
      <h1>The Vyzkaris Covenant</h1>
      <p class="subtitle">Order within chaos &middot; Strength through unity</p>
    </div>
  </div>
</header>

<main{% if wide %} class="wide"{% endif %}>
  {{ content | safe }}
</main>

<footer>{% if site.motto %}<span class="motto">{{ site.motto }}</span>{% else %}Order within chaos <span>&middot;</span> Strength through unity{% endif %}</footer>
</body>
</html>
